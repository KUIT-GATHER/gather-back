+    @Transactional(readOnly = true)
+    public List<PostingMapItem> getPostingsMap(
+            Long regionId,
+            LocalDate activityStartDate,
+            LocalDate activityEndDate,
+            PostingCategory category,
+            BigDecimal swLat,
+            BigDecimal swLng,
+            BigDecimal neLat,
