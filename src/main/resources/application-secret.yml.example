# application-secret.yml 예시 파일.
# 이 파일을 application-secret.yml로 복사한 뒤 값을 채우세요. (application-secret.yml은 gitignore됨)
#
# jwt.secret: JWT Access Token 서명에 사용하는 Base64 인코딩 비밀키.
#   - Base64 디코딩 후 최소 32바이트 이상이어야 하며, 미달 시 애플리케이션이 기동되지 않습니다.
#   - 생성 예시: openssl rand -base64 48 (64로 하면 출력이 두 줄로 잘려 복붙 시 Base64 오류 발생)
#   - 시크릿은 각자 로컬에서 생성하면 되고, 팀원끼리 같을 필요 없습니다.
#
# 운영(EC2)에서는 이 파일 대신 /etc/gather/gather.env의 JWT_SECRET 환경변수로 주입합니다.
jwt:
  secret: your_base64_encoded_secret_here

# volunteer-api.service-key: 1365 자원봉사포털(공공데이터포털) 봉사참여정보 API 인증키.
#   - base-url은 공개 application.yml에 이미 설정돼 있어 여기서는 service-key만 채우면 됩니다.
#   - data.go.kr에서 각자 계정으로 발급받는 것을 권장합니다.
volunteer-api:
  service-key: your_1365_service_key_here

# 카카오 로그인. 두 값이 모두 없으면 애플리케이션이 기동되지 않습니다.
#   - rest-api-key: 카카오디벨로퍼스 REST API 키(= OAuth client_id). 프론트에도 공유하는 값입니다.
#   - client-secret: REST API 키의 Client Secret. 콘솔에서 활성화돼 있어 토큰 교환에 필수이며,
#     누락하면 KOE010(Bad client credentials)으로 실패합니다. 백엔드 전용이라 프론트에 전달하지 않습니다.
# 운영(EC2)에서는 이 파일 대신 /etc/gather/gather.env의
# KAKAO_REST_API_KEY / KAKAO_CLIENT_SECRET 환경변수로 주입합니다.
kakao:
  rest-api-key: your_kakao_rest_api_key_here
  client-secret: your_kakao_client_secret_here

# 탈퇴 후 재가입 제한 식별자 HMAC 전용 키.
# JWT 키와 반드시 다른 값을 사용하세요.
# Base64 디코딩 후 최소 32바이트 이상. 생성 예시: openssl rand -base64 48
# 운영(EC2)에서는 GATHER_AUTH_REJOIN_BLOCK_HMAC_SECRET 환경변수로 주입합니다.
gather:
  auth:
    rejoin-block-hmac:
      secret: your_base64_encoded_rejoin_block_hmac_secret_here
      key-version: 1
    # 카카오 회원번호 AES-256-GCM 암호화 전용 키.
    # JWT 및 rejoin-block-hmac 키와 반드시 다른 값을 사용하세요.
    # Base64 디코딩 후 정확히 32바이트. 생성 예시: openssl rand -base64 32
    # 운영에서는 GATHER_AUTH_SOCIAL_ACCOUNT_ENCRYPTION_KEY /
    # GATHER_AUTH_SOCIAL_ACCOUNT_ENCRYPTION_KEY_VERSION 환경변수로 주입합니다.
    # 현재는 단일 활성 키만 지원하므로 기존 암호문 재암호화/keyring 준비 없이 key-version을 변경하지 마세요.
    social-account-encryption:
      key: your_base64_encoded_32_byte_social_account_encryption_key_here
      key-version: 1
  # email:
  #   mode: smtp

# (선택) 이메일 인증 코드를 실제로 발송하고 싶을 때만 아래 주석을 풀고 값을 채우세요.
# 없으면 기본 log 모드(인증 코드가 서버 로그로 출력)로 동작합니다.
# password는 Gmail 계정 비밀번호가 아니라 "앱 비밀번호"(공백 없이 16자리)입니다.
#spring:
#  mail:
#    username: your_gmail_address_here
#    password: your_google_app_password_here

# 운영(EC2)에서 Refresh Token 쿠키를 HTTPS 전용으로 발급하려면
# /etc/gather/gather.env에 GATHER_REFRESH_COOKIE_SECURE=true를 설정하세요.

# 프로필 이미지 S3 설정(GATHER_AWS_*)은 자격 증명이 아니므로 이 파일에 두지 않습니다.
# 로컬은 application.yml의 기본값으로 기동되고, 운영은 /etc/gather/gather.env 환경변수로 주입합니다.
# AWS Access Key/Secret Key는 설정하지 않고 EC2 IAM Role의 기본 자격 증명 체인을 사용합니다.
# 자세한 내용은 document/profile-image-upload-guide.md를 참고하세요.
