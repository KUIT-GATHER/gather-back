# Gather Backend production environment example
#
# Copy the required keys to /etc/gather/gather.env and replace placeholders there.
# Never commit or share the filled production file.
# Keep KEY=value unquoted because the current deploy validator expects that format.

# Datasource: required by Spring Boot and Flyway
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/gather?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=<required-db-username>
SPRING_DATASOURCE_PASSWORD=<required-db-password>

# JWT and account protection: required
JWT_SECRET=<required-base64-secret-at-least-32-bytes>
GATHER_AUTH_REJOIN_BLOCK_HMAC_SECRET=<required-base64-secret-at-least-32-bytes>
GATHER_AUTH_REJOIN_BLOCK_HMAC_KEY_VERSION=1
GATHER_AUTH_SOCIAL_ACCOUNT_ENCRYPTION_KEY=<required-base64-32-byte-key>
GATHER_AUTH_SOCIAL_ACCOUNT_ENCRYPTION_KEY_VERSION=1

# Kakao OAuth: required
KAKAO_REST_API_KEY=<required-kakao-rest-api-key>
KAKAO_CLIENT_SECRET=<required-kakao-client-secret>

# Kakao Admin/unlink: both flags must be explicitly present for the current deploy validator
KAKAO_ADMIN_ENABLED=false
KAKAO_UNLINK_WORKER_ENABLED=false
# Required only when KAKAO_ADMIN_ENABLED=true
# KAKAO_ADMIN_KEY=<required-kakao-admin-key>

# Production email and Refresh Cookie contract
# These are operationally required but are not all enforced by the current develop validator.
GATHER_EMAIL_MODE=smtp
SPRING_MAIL_USERNAME=<required-smtp-username>
SPRING_MAIL_PASSWORD=<required-smtp-app-password>
GATHER_REFRESH_COOKIE_SECURE=true
GATHER_REFRESH_COOKIE_SAME_SITE=Lax

# S3: required by deploy.sh; AWS credentials come from the EC2 Instance Profile
GATHER_AWS_REGION=ap-northeast-2
GATHER_AWS_S3_BUCKET=<required-bucket-name>
GATHER_AWS_S3_PUBLIC_BASE_URL=https://<required-bucket-name>.s3.ap-northeast-2.amazonaws.com

# 1365 volunteer posting synchronization
VOLUNTEER_API_SERVICE_KEY=<required-1365-service-key>

# Optional manual synchronization endpoint. Keep disabled unless an operator is using the runbook.
POSTING_SYNC_MANUAL_ENDPOINT_ENABLED=false
