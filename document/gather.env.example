# Gather Backend production environment example
#
# Copy the required keys to /etc/gather/gather.env and replace placeholders there.
# Never commit or share the filled production file.
# Keep KEY=value unquoted because the current deploy validator expects that format.

# JVM, Spring runtime, and datasource: required
JAVA_TOOL_OPTIONS=-Duser.timezone=UTC
SPRING_PROFILES_ACTIVE=prod
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/gather_db?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=<required-db-username>
SPRING_DATASOURCE_PASSWORD=<required-db-password>

# JWT and account protection: required
JWT_SECRET=<required-base64-secret-at-least-32-bytes>
GATHER_AUTH_REJOIN_BLOCK_HMAC_SECRET=<required-base64-secret-at-least-32-bytes>
GATHER_AUTH_REJOIN_BLOCK_HMAC_KEY_VERSION=1
GATHER_AUTH_SOCIAL_ACCOUNT_ENCRYPTION_KEY=<required-base64-32-byte-key>
GATHER_AUTH_SOCIAL_ACCOUNT_ENCRYPTION_KEY_VERSION=1

# Kakao OAuth: required
KAKAO_REST_API_KEY=<required-kakao-rest-api-key>
KAKAO_CLIENT_SECRET=<required-kakao-client-secret>
KAKAO_REDIRECT_URIS=<required-comma-separated-kakao-redirect-uris>
KAKAO_SIGNUP_TOKEN_EXPIRATION_SECONDS=900

# Kakao Admin API: keep disabled until the Admin key and unlink operation are ready
KAKAO_ADMIN_ENABLED=false
# Required only when KAKAO_ADMIN_ENABLED=true
# KAKAO_ADMIN_KEY=<required-kakao-admin-key>
KAKAO_ADMIN_API_BASE_URL=https://kapi.kakao.com
KAKAO_ADMIN_CONNECT_TIMEOUT=2s
KAKAO_ADMIN_READ_TIMEOUT=5s

# Kakao unlink worker: keep disabled on the initial deployment
KAKAO_UNLINK_WORKER_ENABLED=false
KAKAO_UNLINK_WORKER_POLL_INTERVAL=30s
KAKAO_UNLINK_WORKER_BATCH_SIZE=10
KAKAO_UNLINK_WORKER_LEASE_DURATION=120s
KAKAO_UNLINK_WORKER_MAXIMUM_ATTEMPTS=12
KAKAO_UNLINK_WORKER_BASE_BACKOFF=1m
KAKAO_UNLINK_WORKER_MAXIMUM_BACKOFF=6h
KAKAO_UNLINK_WORKER_IDENTIFIER=<required-unique-worker-identifier>

# Configuration-blocked recovery is a one-shot operation. Keep disabled during normal service.
KAKAO_UNLINK_RESUME_ENABLED=false

# Global scheduler switch. Set false only for controlled maintenance or one-shot recovery.
GATHER_SCHEDULING_ENABLED=true

# Production email and Refresh Cookie contract enforced by the deploy validator
GATHER_EMAIL_MODE=smtp
SPRING_MAIL_USERNAME=<required-smtp-username>
SPRING_MAIL_PASSWORD=<required-smtp-app-password>

# Refresh Cookie settings used by application.yml and the deploy validator
GATHER_REFRESH_COOKIE_SECURE=true
GATHER_REFRESH_COOKIE_SAME_SITE=Lax

# Comma-separated frontend origins allowed by CORS
GATHER_CORS_ALLOWED_ORIGINS=<required-comma-separated-allowed-origins>

# S3: required by deploy.sh; AWS credentials come from the EC2 Instance Profile
GATHER_AWS_REGION=ap-northeast-2
GATHER_AWS_S3_BUCKET=<required-bucket-name>
GATHER_AWS_S3_PUBLIC_BASE_URL=https://<required-bucket-name>.s3.ap-northeast-2.amazonaws.com

# 1365 volunteer posting synchronization
VOLUNTEER_API_SERVICE_KEY=<required-1365-service-key>

# OCTOMO phone verification: required by the deploy validator
OCTOMO_API_KEY=<required-octomo-api-key>

# The scheduled synchronization defaults to enabled when this key is absent.
# Keep false for the initial deployment, then enable after the first manual verification.
POSTING_SYNC_SCHEDULER_ENABLED=false

# Keep the manual endpoint disabled except during an operator-controlled synchronization.
POSTING_SYNC_MANUAL_ENDPOINT_ENABLED=false
